# ============================================
# ContentFlow AI - Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/contentflow_ai?schema=public"

# ============================================
# SERVER
# ============================================
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ============================================
# JWT & AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# STRIPE (Payment Processing)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_STARTER=price_starter_plan_id
STRIPE_PRICE_PROFESSIONAL=price_professional_plan_id
STRIPE_PRICE_AGENCY=price_agency_plan_id

# ============================================
# OPENAI (Content Generation)
# ============================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ============================================
# REPLICATE (Image Generation)
# ============================================
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_replicate_api_token

# ============================================
# VALUESERP (SERP Analysis & Keyword Research)
# ============================================
# Get from: https://www.valueserp.com/dashboard
VALUESERP_API_KEY=your_valueserp_api_key

# ============================================
# DATAFORSEO (Backlink Analysis & Keyword Data)
# ============================================
# Get from: https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# ============================================
# REDIS (BullMQ Job Queue & Caching)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ============================================
# EMAIL (SendGrid or Amazon SES)
# ============================================
# Option 1: SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@contentflow.ai

# Option 2: Amazon SES (comment out if using SendGrid)
# AWS_SES_ACCESS_KEY_ID=your_aws_access_key
# AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_SES_REGION=us-east-1

# ============================================
# FILE STORAGE (AWS S3 or Cloudflare R2)
# ============================================
# Option 1: AWS S3
AWS_S3_ACCESS_KEY_ID=your_aws_access_key
AWS_S3_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=contentflow-ai-uploads
AWS_S3_REGION=us-east-1

# Option 2: Cloudflare R2 (comment out if using S3)
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET=contentflow-ai-uploads
# R2_ACCOUNT_ID=your_cloudflare_account_id

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
